{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>haproxy-haptic/renovate-runner"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__fixtures__/**"
  ],
  "gomod": {
    "managerFilePatterns": [
      "go.mod",
      "test/go.mod"
    ]
  }
}
